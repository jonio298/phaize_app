# Never commit actual credentials. Gateway MUST listen on loopback only.
PHAIZE_HOST=127.0.0.1
PHAIZE_PORT=8787
PHAIZE_MOBILE_TOKEN=replace-with-32-plus-random-characters
# PHAIZE_DEMO=1 for sample state only; never use demo to authorize live operations.
PHAIZE_DEMO=1
# For real adapter: point to a local desktop-owned, authenticated IPC service.
# PHAIZE_DESKTOP_BRIDGE_URL=http://127.0.0.1:8790
# PHAIZE_DESKTOP_BRIDGE_TOKEN=another-strong-random-secret
